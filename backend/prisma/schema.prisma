generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AiConfiguration {
  id           String   @id @default("ai-config")
  systemPrompt String   @db.Text
  temperature  Float    @default(0.7)
  topP         Float    @default(0.9)
  memorySize   Int      @default(10)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("ai_configurations")
}

model ErpConfiguration {
  id             String    @id @default(uuid())
  context        String
  description    String    @db.Text
  query          String    @db.Text
  expectedFields String[]
  tableName      String
  primaryKey     String?   // Campo definido como Chave Primária (PK)

  // Estratégia de sincronização e paginação incremental (FULL ou HASH_COMPARATOR)
  syncStrategy   String    @default("FULL") // FULL ou HASH_COMPARATOR
  lastSyncCursor String?
  batchSize      Int       @default(1000)
  activeColumn   String?
  activeValue    String?

  // Agendamento da atualização automática
  syncFrequency   String    @default("HOURS") // MINUTES, HOURS, DAILY, MONTHLY, MANUAL
  syncInterval    Int?      @default(1)       // Quantidade de minutos ou horas
  syncTime        String?   @default("08:00") // Horário do dia (HH:mm) para DIÁRIO e MENSAL
  syncDayOfMonth  Int?      @default(1)       // Dia do mês (1 a 31) para MENSAL
  syncActive      Boolean   @default(true)
  lastSyncAt      DateTime?
  nextSyncAt      DateTime?
  lastSyncStatus  String?   // SUCCESS, ERROR, RUNNING
  lastSyncMessage String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("erp_configurations")
}

model MetaTable {
  id          String       @id @default(uuid())
  tenantId    String
  tableName   String
  description String       @db.Text
  columns     MetaColumn[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, tableName])
  @@index([tenantId])
  @@map("meta_tables")
}

model MetaColumn {
  id                 String    @id @default(uuid())
  metaTableId        String
  columnName         String
  dataType           String    @default("TEXT")
  description        String    @db.Text
  isPrimaryKey       Boolean   @default(false)
  foreignKeyToTable  String?
  foreignKeyToColumn String?
  metaTable          MetaTable @relation(fields: [metaTableId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([metaTableId, columnName])
  @@index([metaTableId])
  @@map("meta_columns")
}

model Usuario {
  id              String             @id @default(uuid())
  nome            String
  email           String             @unique
  senha_hash      String             @map("senha_hash")
  usuario_erp     String             @map("usuario_erp")
  cod_gerente_erp String             @map("cod_gerente_erp")
  tipo_acesso     String             @default("GERENTE") @map("tipo_acesso") // ADMIN | GERENTE
  criado_em       DateTime           @default(now()) @map("criado_em")
  atualizado_em   DateTime           @updatedAt @map("atualizado_em")
  dashboards      UserDashboard[]
  conversations   ChatConversation[]
  memories        UserMemory[]
  feedbacks       ChatFeedback[]

  @@map("usuarios")
}

model ChatFeedback {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  conversationId    String?   @map("conversation_id")
  messageId         String?   @map("message_id")
  rating            String    // 'POSITIVE' | 'NEGATIVE'
  tags              Json?     // Array de motivos/tags selecionados
  comment           String?   @db.Text
  userPrompt        String    @map("user_prompt") @db.Text
  assistantResponse String    @map("assistant_response") @db.Text
  contextSummary    String?   @map("context_summary") @db.Text
  generatedSql      String?   @map("generated_sql") @db.Text
  fullConversation  Json?     @map("full_conversation")
  status            String    @default("PENDING") // 'PENDING' | 'RESOLVED'
  resolvedAt        DateTime? @map("resolved_at")
  resolvedBy        String?   @map("resolved_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  usuario           Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([rating, status, createdAt])
  @@map("chat_feedbacks")
}

model ChatConversation {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  title           String        @default("Nova Conversa")
  summary         String?       @db.Text
  compactedUpToId String?       @map("compacted_up_to_id")
  isPinned        Boolean       @default(false) @map("is_pinned")
  messageCount    Int           @default(0) @map("message_count")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  messages        ChatMessage[]

  usuario         Usuario       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  role           String           // 'user' | 'assistant'
  content        String           @db.Text
  isCompacted    Boolean          @default(false) @map("is_compacted")
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model UserMemory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  category  String   @default("PREFERENCIA_GERAL") // PREFERENCIA_COMUNICACAO | PREFERENCIA_ANALISE | CONTEXTO_CARGO_FOCO | PREFERENCIA_GERAL
  fact      String   @db.Text
  source    String   @default("AUTO") // AUTO | MANUAL
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuario   Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("user_memories")
}

model UserDashboard {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  title       String            @default("Meu Dashboard")
  widgets     DashboardWidget[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  usuario     Usuario           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_dashboards")
}

model DashboardWidget {
  id              String        @id @default(uuid())
  dashboardId     String        @map("dashboard_id")
  title           String
  type            String        // 'bar' | 'horizontal-bar' | 'line' | 'area' | 'pie' | 'table'
  queryPrompt     String        @db.Text
  sqlQuery        String?       @db.Text
  cachedData      Json?
  colSpan         Int           @default(1) @map("col_span") // 1 (1 col), 2 (2 cols), 3 (3 cols / largura total)
  rowSpan         Int           @default(1) @map("row_span") // 1 (padrão), 2 (expandido)
  order           Int           @default(0)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  dashboard       UserDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  @@map("dashboard_widgets")
}


